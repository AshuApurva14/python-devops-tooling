from flask import Flask, request

app = Flask(__name__)

@app.route('/webhook', methods=['POST'])
def webhook():
    # TODO: Get JSON data from the request and print it
    data = request.get_json()
    for alert in data.get('alerts', []):
        labels = alert.get('labels', {})
        annotations = alert.get('annotation', {})
        status = alert.get('status', '').upper()
        alertname = labels.get('alertname', 'Uknown')
        job = labels.get('job', 'Unknown')
        instance = labels.get('instance', 'Uknown')
        summary = annotations.get('summary', '')
        print(f"ALERT {status}: {alertname} for job  {job} on instance {instance}. Summary: {summary}")
    return "Alerts processed", 200

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000)
